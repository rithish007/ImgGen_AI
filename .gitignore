# Virtual environments — never commit, remote rebuilds from requirements.txt
ImgGenEnv/
venv/
.venv/
.venv_sam3/

# IDE
.idea/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Model weights & HF cache — live on the RunPod network volume, not in git
*.safetensors
*.ckpt
*.pth
*.bin
*.gguf
*.pt
weights/
.cache/
hf_cache/

# Pipeline outputs — pulled back selectively, not version-controlled wholesale
outputs/
runs/
dataset/
results/
scratch/
logs/
*.png
*.jpg
*.jpeg
*.npy

# Large presentation binaries (the SVG sources below stay tracked).
# assets/*.pdf only - literature/*.pdf are reference papers and stay tracked.
*.pptx
assets/*.pdf
~$*

# Local session state
.job_tracking_state.json

# Keep manifests, configs and reports — they are the reproducibility record.
# reports/ is nested one level deep (class_counts/, water_stats/, analysis/),
# so these need ** rather than the single-level * they used before the reorg.
!manifests/*.json
!configs/*.json
!reports/**/*.json
!reports/**/*.md
!assets/*.svg

# Secrets
.env
*.pem
*_token
.hf_env
